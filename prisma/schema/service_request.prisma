model ServiceRequest {
  id             String          @id @default(uuid())
  trackingNumber String          @unique
  civicIssueId   String?
  categoryId     String?
  municipalityId String
  citizenId      String
  locationId     String?
  description    String
  status         LifecycleStatus @default(SUBMITTED)

  submittedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  civicIssue   CivicIssue?      @relation(fields: [civicIssueId], references: [id], onDelete: SetNull)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  municipality Municipality     @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  citizen      CitizenProfile   @relation(fields: [citizenId], references: [userId], onDelete: Cascade)
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reporters    IssueReporter[]
  feedback     Feedback?
  attachments  Attachment[]

  @@index([citizenId, createdAt])
  @@index([municipalityId, status])
  @@index([civicIssueId])
  @@index([categoryId])
  @@index([status, submittedAt])
}
