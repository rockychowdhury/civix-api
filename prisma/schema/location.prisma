model Location {
  id             String        @id @default(uuid())
  latitude       Float?
  longitude      Float?
  address        String
  landmark       String?
  wardId         String?
  zoneId         String?
  municipalityId String?

  ward           Ward?         @relation(fields: [wardId], references: [id], onDelete: SetNull)
  zone           Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

