model CivicIssue {
  id             String          @id @default(uuid())
  issueNumber    String          @unique
  municipalityId String
  categoryId     String?
  locationId     String?
  departmentId   String?
  wardId         String?
  title          String
  description    String
  status         LifecycleStatus @default(IN_PROGRESS)
  priorityId     String
  reportedCount  Int             @default(1)

  firstReportedAt      DateTime  @default(now())
  lastReportedAt       DateTime  @default(now())
  responseDeadlineAt   DateTime?
  resolutionDeadlineAt DateTime?
  closedAt             DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  municipality    Municipality             @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  category        ServiceCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location        Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department      Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ward            Ward?                    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  priority        PriorityLevel            @relation(fields: [priorityId], references: [id])
  serviceRequests ServiceRequest[]
  reporters       IssueReporter[]
  statusHistory   CivicIssueHistory[]
  workOrders      WorkOrder[]
  escalations     Escalation[]
  verifications   ResolutionVerification[]

  @@index([municipalityId, status])
  @@index([municipalityId, priorityId, status])
  @@index([status, responseDeadlineAt])
  @@index([status, resolutionDeadlineAt])
  @@index([categoryId, status])
  @@index([municipalityId, createdAt])
  @@index([locationId])
  @@index([departmentId, status])
  @@index([wardId, status])
}
