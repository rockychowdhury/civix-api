model SlaPolicy {
  id             String @id @default(uuid())
  municipalityId String
  categoryId     String
  priorityId     String

  responseMinutes   Int
  resolutionMinutes Int
  version           Int            @default(1)
  assignmentType    AssignmentType @default(INDIVIDUAL)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  municipality Municipality    @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority     PriorityLevel   @relation(fields: [priorityId], references: [id])

  @@index([municipalityId, categoryId, priorityId])
}
