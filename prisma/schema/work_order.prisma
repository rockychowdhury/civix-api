model WorkOrder {
  id                String          @id @default(uuid())
  civicIssueId      String
  departmentId      String
  currentAssigneeId String?
  title             String
  description       String?
  status            LifecycleStatus @default(WORK_ORDER_CREATED)
  priority          IssuePriority   @default(MEDIUM)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  civicIssue      CivicIssue    @relation(fields: [civicIssueId], references: [id], onDelete: Cascade)
  department      Department    @relation(fields: [departmentId], references: [id])
  currentAssignee StaffProfile? @relation(fields: [currentAssigneeId], references: [userId], onDelete: SetNull)

  assignments Assignment[]
  updates     WorkUpdate[]
  resolution  Resolution?

  @@index([civicIssueId])
  @@index([departmentId])
  @@index([currentAssigneeId, status])
  @@index([status, createdAt])
}
