model Assignment {
  id           String  @id @default(uuid())
  workOrderId  String
  assignedToId String?
  assignedById String?
  teamId       String?

  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  unassignedAt DateTime?
  status       AssignmentStatus @default(PENDING)
  reason       String?
  notes        String?
  createdAt    DateTime         @default(now())

  workOrder  WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  team       Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedTo StaffProfile? @relation("AssignedTo", fields: [assignedToId], references: [userId], onDelete: Cascade)
  assignedBy StaffProfile? @relation("AssignedBy", fields: [assignedById], references: [userId], onDelete: SetNull)

  @@index([assignedToId, status])
  @@index([workOrderId, status])
}
