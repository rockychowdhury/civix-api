<h1>Hello <%= name %></h1>
<p>Your OTP to reset password is: <strong><%= otp %></strong></p>
<p>This OTP will expire in <%= expirationMinutes %> minutes.</p>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Your Password - Civix</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f9fafb; margin: 0; padding: 0; line-height: 1.6; color: #374151; }
        .container { max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .header { background-color: #ef4444; color: #ffffff; text-align: center; padding: 24px; }
        .header h1 { margin: 0; font-size: 28px; font-weight: 600; letter-spacing: 1px; }
        .content { padding: 32px; }
        .greeting { font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px; }
        .text { font-size: 16px; margin-bottom: 24px; }
        .otp-container { text-align: center; margin: 32px 0; }
        .otp-code { font-size: 36px; font-weight: 700; letter-spacing: 8px; color: #ef4444; background-color: #fef2f2; padding: 16px 32px; border-radius: 8px; display: inline-block; border: 1px solid #fecaca; }
        .footer { background-color: #f3f4f6; padding: 24px; text-align: center; font-size: 14px; color: #6b7280; }
        .footer a { color: #ef4444; text-decoration: none; }
        .security-note { font-size: 13px; color: #6b7280; margin-top: 32px; padding-top: 24px; border-top: 1px solid #e5e7eb; }
        .highlight { font-weight: 600; color: #111827; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Civix</h1>
        </div>
        <div class="content">
            <div class="greeting">Hello <%= name %>,</div>
            <div class="text">
                We received a request to reset the password associated with your Civix account. Please use the One-Time Password (OTP) below to proceed:
            </div>
            
            <div class="otp-container">
                <div class="otp-code"><%= otp %></div>
            </div>

            <div class="text">
                This OTP is valid for <span class="highlight"><%= expirationMinutes %> minutes</span>. If you close your browser or navigate away, you may need to request a new code.
            </div>

            <div class="security-note">
                <strong>Security Alert:</strong> If you did not request a password reset, please ignore this email. Your password will remain unchanged. We strongly recommend ensuring your account is secure.
            </div>
        </div>
        <div class="footer">
            <p>&copy; 2026 Civix. All rights reserved.</p>
            <p>Need help? Contact our <a href="#">Support Team</a></p>
            <p>Please do not reply to this automated email.</p>
        </div>
    </div>
</body>
</html>
