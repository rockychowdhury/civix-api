<h1>Hello <%= name %></h1>
<p>Your password has been successfully reset.</p>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Successful - Civix</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f9fafb; margin: 0; padding: 0; line-height: 1.6; color: #374151; }
        .container { max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .header { background-color: #10b981; color: #ffffff; text-align: center; padding: 24px; }
        .header h1 { margin: 0; font-size: 28px; font-weight: 600; letter-spacing: 1px; }
        .content { padding: 32px; }
        .greeting { font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 16px; }
        .text { font-size: 16px; margin-bottom: 24px; }
        .success-box { background-color: #ecfdf5; border-left: 4px solid #10b981; padding: 16px; margin: 24px 0; color: #065f46; font-weight: 500; }
        .button-container { text-align: center; margin: 32px 0; }
        .button { background-color: #10b981; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block; }
        .footer { background-color: #f3f4f6; padding: 24px; text-align: center; font-size: 14px; color: #6b7280; }
        .footer a { color: #10b981; text-decoration: none; }
        .security-note { font-size: 13px; color: #6b7280; margin-top: 32px; padding-top: 24px; border-top: 1px solid #e5e7eb; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Civix</h1>
        </div>
        <div class="content">
            <div class="greeting">Hello <%= name %>,</div>
            <div class="success-box">
                Your password has been successfully reset!
            </div>
            
            <div class="text">
                You can now log in to your Civix account using your new password. We recommend updating your password regularly to keep your account safe.
            </div>

            <div class="button-container">
                <a href="#" class="button">Log In to Your Account</a>
            </div>

            <div class="security-note">
                <strong>Security Alert:</strong> If you did not perform this password reset, please contact our support team immediately to secure your account, as your credentials may have been compromised.
            </div>
        </div>
        <div class="footer">
            <p>&copy; 2026 Civix. All rights reserved.</p>
            <p>Need help? Contact our <a href="#">Support Team</a></p>
            <p>Please do not reply to this automated email.</p>
        </div>
    </div>
</body>
</html>
