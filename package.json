	"description": "Civix Api Backend",
	"license": "ISC",
	"author": "Rocky Chowdhury",
	"type": "module",
	"main": "server.ts",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsup",
		"start": "node dist/src/server.js",
		"test": "echo \"Error: no test specified\" && exit 1",
		"format:check": "npx @biomejs/biome format ./src",
		"format:fix": "npx @biomejs/biome format --write ./src",
		"lint:check": "npx @biomejs/biome lint ./src",
		"lint:fix": "npx @biomejs/biome lint --write ./src",
		"seed": "tsx src/utils/seed/run-seeds.ts"
	},
	"prisma": {
		"seed": "tsx src/utils/seed/run-seeds.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.6",
		"@types/express-list-endpoints": "^6.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.4.1",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.23.1",
		"express-list-endpoints": "^7.1.1",
		"prisma": "^7.10.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcryptjs": "^3.0.3",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"ejs": "^6.0.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"google-auth-library": "^11.0.2",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.3.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^9.1.1",
		"pg": "^8.23.0",
		"redis": "^6.2.1",
		"zod": "^4.5.4"
	}
